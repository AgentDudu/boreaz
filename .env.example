# Boreaz environment overrides.
#
# Copy to `.env` next to the executable and fill in only what you need. `.env` is
# git-ignored and must never be committed; this file stays committed and every value
# here stays empty. An unset key means "use the default", so a missing `.env` is fine
# and never an error.
#
# Anything machine-specific belongs here, never in code: the hygiene test in
# tests/test_hygiene.cpp fails the build if a real value ever appears in a tracked file.

# Audio output device name, exactly as it appears in `boreaz --list`. Empty = system default.
BOREAZ_AUDIO_DEVICE=

# MIDI input client name, exactly as it appears in `boreaz --list`. Empty = first client,
# or the built-in virtual port when no hardware is present.
BOREAZ_MIDI_INPUT=

# Preferred engine rate and period, in frames. Empty = ask the device.
BOREAZ_SAMPLE_RATE=
BOREAZ_PERIOD_FRAMES=

# Path to an SFZ instrument to load at startup. Empty = built-in synth voice only.
BOREAZ_INSTRUMENT=

# Where to write the rendered WAV when no output path is given on the command line.
# Empty = the current directory.
BOREAZ_RENDER_DIR=

# Overrides the config directory (default: %APPDATA%\Boreaz). Useful for a portable install.
BOREAZ_CONFIG_DIR=

# Where downloaded instruments are cached (default: inside the config directory).
BOREAZ_ASSET_CACHE=
